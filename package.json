{
  "name": "mohammad-farhan-shaikh-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build && node tools/prerender.mjs",
    "build:fast": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "serve": "node tools/serve.mjs dist --port 4400",
    "fonts": "node tools/subset-fonts.mjs",
    "qa:audit": "node tools/qa/audit.mjs http://127.0.0.1:4400/ --max 40",
    "qa:shoot": "node tools/qa/shoot.mjs http://127.0.0.1:4400/ --out .shots --crawl --nav --steps 6"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "axe-core": "^4.11.0",
    "playwright": "^1.56.0",
    "subset-font": "^2.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.1"
  }
}
